%% Mock architecture for an assumed Spring Boot application using JWT + Spring Security.
%% Domain relationships are derived from database/schema/tadpoles_schema.sql.

namespace Security {
    class SecurityConfig {
        +securityFilterChain(HttpSecurity)
        +passwordEncoder()
        +authenticationProvider()
    }

    class JwtAuthenticationFilter {
        +doFilterInternal(req, res, chain)
    }

    class JwtService {
        +generateToken(userDetails)
        +extractUsername(token)
        +isTokenValid(token, userDetails)
    }

    class CustomUserDetailsService {
        +loadUserByUsername(username)
    }

    class AuthenticationService {
        +register(request)
        +authenticate(request)
        +refreshToken(request)
        +logout(request)
    }

    class AppUser {
        +Long id
        +String username
        +String email
        +String displayName
        +String passwordHash
        +Boolean enabled
    }

    class Role {
        <<enumeration>>
        ADMIN
        AUDITOR
        ANALYST
        ADVISOR
        CLIENT
    }

    class AuthController {
        +register(RegisterRequest)
        +login(LoginRequest)
        +refreshToken()
    }

    class LoginRequest {
        +String username
        +String password
    }

    class RegisterRequest {
        +String username
        +String password
        +List<Role> roles
        +Long advisorId
        +Long clientId
    }

    class JwtResponse {
        +String accessToken
        +String refreshToken
    }
}

namespace Controllers {
    class AdvisorController {
        +getAdvisorClients(advisorId)
        +getAdvisorPortfolios(advisorId)
    }

    class ClientController {
        +getClient(clientId)
        +createClient(request)
        +assignAdvisor(clientId, advisorId)
        +subscribeToModel(clientId, portfolioId)
    }

    class PortfolioController {
        +getModelPortfolio(portfolioId)
        +createModelPortfolio(request)
        +setTargetAllocation(portfolioId, holdings)
    }

    class HoldingsController {
        +getClientHoldings(clientId)
        +getPortfolioDrift(clientId)
    }

    class TradeController {
        +placeClientTrade(clientId, request)
        +getTradesByClient(clientId)
        +getTradeById(tradeId)
    }

    class TradeSuggestionController {
        +createSuggestion(advisorId, clientId, request)
        +getSuggestionsByClient(clientId)
        +getSuggestionsByAdvisor(advisorId)
        +updateSuggestionStatus(suggestionId, request)
    }
}

namespace Services {
    class AdvisorService {
        +findById(advisorId)
        +getClients(advisorId)
    }

    class ClientService {
        +createClient(request)
        +getClientSummary(clientId)
        +assignAdvisor(clientId, advisorId)
    }

    class PortfolioService {
        +createPortfolio(request)
        +addHolding(portfolioId, instrumentId, targetWeightPct)
        +getTargetAllocation(portfolioId)
    }

    class SubscriptionService {
        +subscribeClient(clientId, portfolioId)
        +getSubscriptions(clientId)
    }

    class HoldingsService {
        +getClientHoldings(clientId)
        +calculateDrift(clientId)
    }

    class TradeService {
        +placeTrade(clientId, request)
        +getTradeHistory(clientId)
        +getTradeById(tradeId)
    }

    class TradeSuggestionService {
        +createSuggestion(advisorId, clientId, request)
        +getSuggestionsByClient(clientId)
        +getSuggestionsByAdvisor(advisorId)
        +updateSuggestionStatus(suggestionId, request)
    }

    class RebalancingService {
        +rebalanceClient(clientId)
        +compareActualVsTarget(clientId)
    }
}

namespace Mappers {
    class UserMapper {
        +selectById(userId)
        +selectByUsername(username)
        +insert(user)
        +update(user)
        +updateEnabled(userId, enabled)
        +selectRoles(userId)
        +replaceRoles(userId, roleIds)
    }

    class RoleMapper {
        +selectAll()
        +selectByName(roleName)
        +insert(role)
    }

    class AdvisorMapper {
        +selectById(advisorId)
        +selectByUserId(userId)
        +selectClients(advisorId)
        +insert(advisor)
        +update(advisor)
    }

    class ClientMapper {
        +selectById(clientId)
        +selectByUserId(userId)
        +selectByAdvisorId(advisorId)
        +insert(client)
        +update(client)
        +assignAdvisor(clientId, advisorId)
        +assignModelPortfolio(clientId, portfolioId)
    }

    class ModelPortfolioMapper {
        +selectById(portfolioId)
        +selectAll()
        +insert(portfolio)
        +update(portfolio)
        +selectCreatedByUserId(userId)
    }

    class InstrumentMapper {
        +selectById(instrumentId)
        +selectByTicker(ticker)
        +selectAll()
        +insert(instrument)
        +update(instrument)
        +setActive(instrumentId, active)
    }

    class ModelPortfolioHoldingMapper {
        +selectByPortfolioId(portfolioId)
        +replaceHoldings(portfolioId, holdings)
        +insertBatch(holdings)
        +deleteByPortfolioId(portfolioId)
    }

    class ClientSubscriptionMapper {
        +selectByClientId(clientId)
        +selectActiveByClientId(clientId)
        +insert(subscription)
        +updateStatus(subscriptionId, status)
        +approve(subscriptionId, approverUserId)
    }

    class TradeSuggestionMapper {
        +selectById(suggestionId)
        +selectByClientId(clientId)
        +selectByAdvisorId(advisorId)
        +insert(suggestion)
        +updateStatus(suggestionId, status)
    }

    class ClientTradeMapper {
        +selectById(tradeId)
        +selectByClientId(clientId)
        +insert(trade)
        +updateStatus(tradeId, status)
    }

    class ClientHoldingMapper {
        +selectLatestByClientId(clientId)
        +upsertSnapshot(holding)
    }

    class RefreshTokenMapper {
        +selectByHash(tokenHash)
        +insert(token)
        +revokeByTokenHash(tokenHash)
        +revokeByUserId(userId)
        +deleteExpired()
    }

    class AuditLogMapper {
        +insert(entry)
        +selectByUserId(userId)
        +selectByEntity(entityName, entityId)
    }
}

namespace Domain {
    class Advisor {
        +Long advisorId
        +String advisorName
    }

    class Client {
        +Long clientId
        +String clientName
    }

    class ModelPortfolio {
        +Long modelPortfolioId
        +String modelName
    }

    class Instrument {
        +Long instrumentId
        +String instrumentName
        +String ticker
        +String currency
    }

    class ModelPortfolioHolding {
        +BigDecimal targetWeightPct
    }

    class ClientSubscription {
        +LocalDate subscribedDate
    }

    class ClientHolding {
        +Double quantity
        +LocalDate asOfDate
    }

    class ClientTrade {
        +Long tradeId
        +TradeType tradeType
        +Double quantity
        +BigDecimal price
        +LocalDate tradeDate
    }

    class TradeSuggestion {
        +Long suggestionId
        +Long advisorId
        +Long clientId
        +Long instrumentId
        +TradeType tradeType
        +Double quantity
        +BigDecimal proposedPrice
        +SuggestionStatus status
        +String notes
    }

    class RefreshToken {
        +Long refreshTokenId
        +Long userId
        +String tokenHash
        +LocalDateTime expiresAt
        +LocalDateTime revokedAt
        +LocalDateTime createdAt
    }

    class AuditLog {
        +Long auditLogId
        +Long userId
        +String entityName
        +String entityId
        +String actionType
        +String oldValues
        +String newValues
        +LocalDateTime createdAt
    }

    class TradeType {
        <<enumeration>>
        BUY
        SELL
    }

    class SuggestionStatus {
        <<enumeration>>
        SUGGESTED
        VIEWED
        ACCEPTED
        REJECTED
        EXPIRED
    }
}

namespace DTOs {
    class ClientSummaryDto {
        +String clientName
        +String advisorName
        +String modelName
    }

    class TradeRequest {
        +Long clientId
        +Long instrumentId
        +TradeType tradeType
        +Double quantity
        +BigDecimal price
    }

    class TradeSuggestionRequest {
        +Long instrumentId
        +TradeType tradeType
        +Double quantity
        +BigDecimal proposedPrice
        +String notes
    }

    class TradeSuggestionSummaryDto {
        +Long suggestionId
        +Long advisorId
        +Long clientId
        +Long instrumentId
        +TradeType tradeType
        +Double quantity
        +SuggestionStatus status
    }

    class TradeSuggestionDecisionRequest {
        +SuggestionStatus status
        +String notes
    }

    class PortfolioDriftDto {
        +Long clientId
        +String ticker
        +BigDecimal actualWeightPct
        +BigDecimal targetWeightPct
    }
}

%% Security relationships
SecurityConfig --> JwtAuthenticationFilter : registers
SecurityConfig --> CustomUserDetailsService : configures
JwtAuthenticationFilter --> JwtService : validates token
JwtAuthenticationFilter --> CustomUserDetailsService : loads principal
AuthenticationService --> JwtService : issues JWT
AuthenticationService --> UserMapper : persists users
AuthenticationService --> RefreshTokenMapper : persists tokens
AuthenticationService --> RoleMapper : resolves roles
AuthController --> AuthenticationService : delegates
AppUser --> Role : has
CustomUserDetailsService --> UserMapper : loads principal

