### Scoped Operations evidence access (local demo values)
# Enables investigation reads; standard local startup grants demo.operations access to demo.client only.
OPERATIONS_ACCESS_ENABLED=true
# Comma-separated purpose codes shown in the UI. Use uppercase letters, digits and underscores.
OPERATIONS_ALLOWED_PURPOSES=ORDER_REVIEW
# A label for this purpose policy. Changing it invalidates existing investigation contexts.
OPERATIONS_POLICY_VERSION=local-demo-v1
# Investigation context lifetime in seconds: 60-3600. 3600 = one hour.
OPERATIONS_CONTEXT_SECONDS=3600
# Download lifetime in seconds: 60-86400. 3600 = one hour; this does not delete stored evidence.
OPERATIONS_EXPORT_SECONDS=3600

